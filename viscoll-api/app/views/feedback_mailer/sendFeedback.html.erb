<div style="font-family: sans-serif; width:100%; height: 100%">
  <hr style="border: 1px solid #4ED6CB;" />

  <div style="padding-left: 20px;">
    <p>Feedback from: <%= @user.email %></p>
    <p>Message:<br> <%= @message %></p>
    <br>
    <p>Browser Information:<br>
      <%= @browserInformation %>
    </p>
    <br>
    <% if @projectJSONExport!=nil %>
      <p> Project JSON Export:<br/>
        <small><%= @projectJSONExport %></small>
      </p>
    <% end %>
  </div>
</div>